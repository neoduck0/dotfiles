      "path": "themes/nordic-nvim.json"
    }
  },
  "icon_themes": {},
  "languages": {
    "CSV": {
      "extension": "csv",
      "path": "languages/csv",
      "matcher": {
        "path_suffixes": [
          "csv"
        ],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "csv"
    },
    "EmmyLuadoc": {
      "extension": "lua",
      "path": "languages/emmyluadoc",
      "matcher": {
        "path_suffixes": [],
